{
  "name": "onbarber-api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply onbarber-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply onbarber-db --remote",
    "db:seed:local": "wrangler d1 execute onbarber-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute onbarber-db --remote --file=./seed.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.9",
    "@cloudflare/workers-types": "^4.20250922.0",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.4",
    "zod": "^4.1.13"
  }
}
